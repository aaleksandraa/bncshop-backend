; systemd unit for Laravel Horizon (alternative to Supervisor)
; WARNING: Do NOT enable alongside Supervisor — use ONE manager only.
; On api.bncshop.ba production we use Supervisor; keep this unit disabled:
;   sudo systemctl disable --now bncshop-horizon
; Copy to /etc/systemd/system/bncshop-horizon.service and adjust paths.
;
;   sudo systemctl daemon-reload
;   sudo systemctl enable bncshop-horizon
;   sudo systemctl start bncshop-horizon

[Unit]
Description=BNC Webshop Laravel Horizon
After=network.target redis.service

[Service]
Type=simple
User=plesk-user
Group=psacln
WorkingDirectory=/var/www/vhosts/DOMAIN/bncshop-backend
ExecStart=/usr/bin/php artisan horizon
Restart=always
RestartSec=5
StopSignal=SIGTERM
TimeoutStopSec=3600

[Install]
WantedBy=multi-user.target
