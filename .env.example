APP_NAME="BNC Webshop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Za produkciju iza nginx/Cloudflare load balancera (potrebno za HTTPS detekciju i IP allowlist):
# TRUSTED_PROXIES=*
# ili TRUSTED_PROXIES=10.0.0.1,10.0.0.2
# Public asset origin for uploaded files (Filament, emails). Defaults to APP_URL.
# ASSET_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

A1_API_BASE_URL=https://a1team.ba
A1_API_USERNAME=
A1_API_PASSWORD=
A1_API_TARGET_SYSTEM_CODE=bnc-shop
A1_API_PAGE_SIZE=500
A1_API_VERIFY_SSL=true

ELINE_API_BASE_URL=https://www8.eline.ba/bl/RestWebShop.svc/json
ELINE_API_TOKEN=
ELINE_API_SHOP_CODE=bncshop
ELINE_API_TIMEOUT=120
ELINE_API_RETRIES=3
ELINE_API_VERIFY_SSL=true
ELINE_SYNC_TIMES=06:00,18:00
ELINE_SYNC_INTERVAL_MINUTES=720

OLX_API_BASE_URL=https://api.olx.ba
OLX_USERNAME=
OLX_PASSWORD=
OLX_DEVICE_NAME=bncshopweb_integration
OLX_SYNC_TIMES=06:00,18:00

# Sanctum token lifetime in minutes (default: 30 days). Set empty to disable expiration.
SANCTUM_TOKEN_EXPIRATION=43200
# SPA cookie auth — comma-separated frontend domains (required for HttpOnly session auth)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# Sentry error monitoring (production)
SENTRY_LARAVEL_DSN=

# Local dev only — set strong unique passwords; never use defaults in production
ADMIN_EMAIL=admin@bncshop.test
ADMIN_PASSWORD=
ADMIN_NAME="BNC Admin"
SELLER_EMAIL=prodavac@bncshop.test
SELLER_PASSWORD=
SELLER_NAME="BNC Prodavac"

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare Turnstile (bot protection).
# Local/dev: false is fine. Production MUST set TURNSTILE_ENABLED=true with real keys.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secure session cookies in production (set true when using HTTPS)
SESSION_SECURE_COOKIE=
# SameSite policy for session cookies (lax for same-site SPA, none for cross-domain with Secure)
SESSION_SAME_SITE=lax
