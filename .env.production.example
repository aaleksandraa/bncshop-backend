# Production .env template — copy to .env on the server.
# RULE: values with spaces MUST be in double quotes (e.g. APP_NAME="BNC Webshop").

APP_NAME="BNC Webshop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.bncshop.ba
# Split-domain setup (admin on api.bnc.ba, legacy /storage on api.bncshop.ba):
#   APP_URL=https://api.bnc.ba          ← MUST match the domain you open in the browser (Filament JS)
#   LEGACY_STORAGE_URL=https://api.bncshop.ba   ← legacy synced images only (NOT Laravel asset_url)
# ASSET_URL is an alias for LEGACY_STORAGE_URL. Do NOT add asset_url to config/app.php.
# ASSET_URL=https://api.bncshop.ba
ASSET_URL=
FRONTEND_URL=https://bncshop.ba

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Behind nginx/Cloudflare — list actual proxy IPs, never use * in production
TRUSTED_PROXIES=10.0.0.1

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bncshop
DB_USERNAME=bncshop
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_DOMAIN=.bncshop.ba
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Mail (Plesk VPS: sendmail + info@bncshop.ba — vidi docs/email-setup.md) ---
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=info@bncshop.ba
MAIL_FROM_NAME="${APP_NAME}"
SELLER_EMAIL=prodaja@bncshop.ba
ADMIN_EMAIL=info@bncshop.ba

B2B_MAIL_FROM_ADDRESS=b2b@bncshop.ba
B2B_MAIL_FROM_NAME="BNC B2B"
B2B_ADMIN_NOTIFICATION_EMAIL=b2b@bncshop.ba

# SMTP alternativa (samo ako je u Plesk-u uključen submission na :587):
# MAIL_MAILER=smtp
# MAIL_HOST=mail.bncshop.ba
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=info@bncshop.ba
# MAIL_PASSWORD=
# MAIL_EHLO_DOMAIN=bncshop.ba

SANCTUM_STATEFUL_DOMAINS=bncshop.ba,www.bncshop.ba
SANCTUM_TOKEN_EXPIRATION=43200

CORS_ALLOWED_ORIGINS=https://bncshop.ba,https://www.bncshop.ba

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

A1_API_BASE_URL=https://a1team.ba
A1_API_USERNAME=
A1_API_PASSWORD=
A1_API_TARGET_SYSTEM_CODE=bnc-shop
A1_API_PAGE_SIZE=500
A1_API_VERIFY_SSL=true

ELINE_API_BASE_URL=https://www8.eline.ba/bl/RestWebShop.svc/json
ELINE_API_TOKEN=
ELINE_API_SHOP_CODE=bncshop
ELINE_API_VERIFY_SSL=true
ELINE_SYNC_TIMES=06:00,18:00

OLX_API_BASE_URL=https://api.olx.ba
OLX_USERNAME=
OLX_PASSWORD=
OLX_DEVICE_NAME=bncshopweb_integration
OLX_SYNC_TIMES=06:00,18:00

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Do NOT add ADMIN_NAME / SELLER_NAME here — use: php artisan make:filament-user
